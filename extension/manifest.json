{
  "manifest_version": 3,
  "name": "The Unplugged Tracking Extension",
  "version": "1.0.0",
  "description": "Tracks limited browser activity to detect attention drift.",
  "permissions": [
    "tabs",
    "storage",
    "alarms"
  ],
  "host_permissions": [
    "*://*/*"
  ],
  "action": {
    "default_popup": "dist/popup.html",
    "default_title": "The Unplugged"
  },
  "background": {
    "service_worker": "dist/background.js",
    "type": "module"
  },
  "content_scripts": [
    {
      "matches": ["<all_urls>"],
      "js": ["dist/content.js"],
      "run_at": "document_idle"
    }
  ]
}
